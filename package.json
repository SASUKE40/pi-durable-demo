{
  "name": "pi-durable-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A crash-and-resume demo using the real pi-durable harness and SQLite storage.",
  "engines": {
    "node": ">=22.19.0"
  },
